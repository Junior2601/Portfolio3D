# Copie ce fichier en .env (jamais commité) et adapte les valeurs.

# Base PostgreSQL : postgres://utilisateur:motdepasse@hote:5432/nom_de_la_base
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paul_studio
# true si l'hébergeur impose SSL (URL « externe » de Render, Neon, Supabase…)
DATABASE_SSL=false

PORT=4000
NODE_ENV=development

# Optionnel : jeton GitHub (lecture seule, aucun droit) pour relever la limite de l'API
GITHUB_TOKEN=

# Optionnel : être prévenu par e-mail à chaque message reçu (https://resend.com)
RESEND_API_KEY=
CONTACT_TO=pauljuniornguessanyao@gmail.com
MAIL_FROM=Portfolio <onboarding@resend.dev>
